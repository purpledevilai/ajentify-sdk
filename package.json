{
  "name": "@ajentify/sdk",
  "version": "0.1.0",
  "description": "Official TypeScript SDK for the Ajentify API. A clean, uniform wrapper over agents, contexts, tools, structured responses, data windows, API keys, JSON documents and models with Zod-first schemas.",
  "type": "module",
  "license": "MIT",
  "author": "Ajentify",
  "homepage": "https://ajentify.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/ajentify/ajentify-sdk"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "optionalDependencies": {
    "zod-to-json-schema": "^3.24.1"
  },
  "peerDependencies": {
    "zod": "^3.22.0 || ^4.0.0"
  },
  "peerDependenciesMeta": {
    "zod": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "tsup": "^8.3.5",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8",
    "zod": "^4.0.0",
    "zod-to-json-schema": "^3.24.1"
  },
  "keywords": [
    "ajentify",
    "ai",
    "agents",
    "sdk",
    "llm",
    "tools",
    "structured-output"
  ]
}
